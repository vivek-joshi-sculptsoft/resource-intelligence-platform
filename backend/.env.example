# Application
APP_NAME="Resource Intelligence Platform"
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/ri_platform
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET_KEY=change-me-generate-another-with-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Sentry (leave empty to disable)
SENTRY_DSN=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
